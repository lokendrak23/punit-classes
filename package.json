{
  "name": "punit-classes-fullstack",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22"},
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "start": "node server/index.mjs",
    "db:setup": "node --env-file=.env server/setup.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server/index.mjs && node --check server/api.mjs && node --check src/main.js"
  }
}
